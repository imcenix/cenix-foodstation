---
import type { CollectionEntry } from 'astro:content';

interface Props {
  restaurant: CollectionEntry<'restaurants'>;
  folder: string;
  mealTags?: string;
  coverVersion?: string;
}

const { restaurant, folder, mealTags = 'all', coverVersion = '1' } = Astro.props;
const { data } = restaurant;
const coverUrl = `/restaurants/${folder}/cover-card.jpg?v=${coverVersion}`;
const fallbackCoverUrl = `/restaurants/${folder}/cover.jpg?v=${coverVersion}`;

const type        = data.type ?? 'restaurant';
const isRestaurant = type === 'restaurant';
const isCook       = type === 'cook';
const isCollect    = type === 'collect';

const formatLocation = (value?: string) => {
  if (!value) return '';
  const location = value.trim();
  if (/da\s*lat|đà\s*lạt/i.test(location)) return 'Đà Lạt';
  const district = location.match(/(?:quận|q\.?)[\s-]*(\d+)/i);
  if (district) return `Quận ${district[1]}`;
  if (/bình\s*chánh/i.test(location)) return 'Bình Chánh';
  return location;
};
const shortLocation = formatLocation(data.neighborhood);
---

<button
  type="button"
  class:list={['r-card', `r-card--${type}`]}
  data-cuisine={data.cuisine}
  data-neighborhood={data.neighborhood}
  data-meal-tags={mealTags}
  data-search={[data.name, data.tagline, data.cuisine, data.neighborhood, ...data.signature_dishes].filter(Boolean).join(' ').toLocaleLowerCase('vi')}
  data-favorite={data.favorite ? '1' : undefined}
  data-explore={data.explore_featured ? '1' : undefined}
  data-modal={`restaurant-${folder}`}
>
  <div class="r-card-media">
    <img
      src={coverUrl}
      alt={data.name}
      width="540"
      height="720"
      loading="lazy"
      decoding="async"
      onerror={`this.onerror=null;this.src='${fallbackCoverUrl}'`}
    />

    {/* Collect badge */}
    {isCollect && (
      <span class="r-card-badge r-card-badge--collect" aria-hidden="true">🔖</span>
    )}

    {/* Cook badge */}
    {isCook && (
      <span class="r-card-badge r-card-badge--cook" aria-hidden="true">👨‍🍳</span>
    )}
  </div>

  <div class="r-card-body">
    <h3 class="r-card-title">{data.name}</h3>

    {data.tagline && (
      <p class="r-card-tagline">{data.tagline}</p>
    )}

    {/* Location is the final supporting detail, separated from the description. */}
    {isRestaurant && shortLocation && (
      <span class="r-card-meta">
        <svg class="r-card-location-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="2.5"></circle>
        </svg>
        <span>{shortLocation}</span>
      </span>
    )}

  </div>
</button>
