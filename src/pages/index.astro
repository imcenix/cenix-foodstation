  <Hero neighborhoods={neighborhoods} initialCategory={initialCategory} />

  <section class="restaurants">
    <div class="container">
      {restaurants.length === 0 ? (
        <div class="empty-state">
          <span class="empty-state-emoji" aria-hidden="true">🍽️</span>
          <h2 class="empty-state-title">Chưa có quán nào</h2>
          <p class="empty-state-text">
            Thêm folder mới dưới <code>assets/restaurants/</code> với file <code>restaurant.md</code> + ảnh <code>cover.jpg</code> để bắt đầu.
          </p>
        </div>
      ) : (
        <>
          <div class="content-rows" id="explore" data-content-rows>
            {contentRows.map((row) => {
              /* Pre-filter cards for this row's permanent filter */
              const rowCards = (() => {
                if (row.filter === 'explore_featured') return sortFavorites(restaurants.filter(r => r.data.explore_featured));
                if (row.filter === 'dalat')            return restaurants.filter(r => getCategory(r) === 'dalat');
                if (row.filter === 'cook')             return restaurants.filter(r => r.data.type === 'cook');
                return restaurants;
              })();

              return (
                <section class="content-row" data-content-row={row.id} data-row-filter={row.filter}>
                  <div class="content-row-head">
                    <h3 data-row-title={row.id}>{row.title}</h3>
                    <div class="content-row-actions">
                      <button class="track-nav" type="button" data-track-prev aria-label="Lùi lại">‹</button>
                      <button class="track-nav" type="button" data-track-next aria-label="Xem tiếp">›</button>
                      <button class="content-row-next content-row-next--desktop" type="button" data-row-more={row.filter} aria-label={`Xem thêm ${row.title}`}>
                        Xem thêm →
                      </button>
                    </div>
                  </div>
                  <div class="content-row-track">
                    {rowCards.slice(0, 10).map((r) => (
                      <RestaurantCard
                        restaurant={r}
                        folder={folderSlug(r.id)}
                        mealTags={getMealTags(r)}
                        coverVersion={getCoverVersion(folderSlug(r.id))}
                      />
                    ))}
                    {/* Mobile: Xem thêm as last card in track */}
                    <button
                      class="content-row-more"
                      type="button"
                      aria-label={`Xem thêm ${row.title}`}
                      data-row-more={row.filter}
                    >
                      <span class="content-row-more__arrow">→</span>
                      <span class="content-row-more__label">Xem<br/>thêm</span>
                    </button>
                  </div>
                </section>
              );
            })}
          </div>

          <div class="category-view" data-category-view hidden>
            <section class="content-row" data-fav-section>
              <div class="content-row-head">
                <h3 data-fav-title>Tui hay ăn nhất</h3>
                <div class="content-row-actions">
                  <button class="track-nav" type="button" data-track-prev aria-label="Lùi lại">‹</button>
                  <button class="track-nav" type="button" data-track-next aria-label="Xem tiếp">›</button>
                </div>
              </div>
              <div class="content-row-track" data-fav-track>
                {sortFavorites(restaurants.filter((r) => r.data.favorite)).map((r) => (
                  <RestaurantCard restaurant={r} folder={folderSlug(r.id)} mealTags={getMealTags(r)} />
                ))}
              </div>
            </section>

            <section class="content-row" data-all-section>
              <div class="content-row-head">
                <h3 data-all-title>Tất cả các quán</h3>
              </div>
              <div class="card-grid" data-all-grid>
                {restaurants.map((r) => (
                  <RestaurantCard restaurant={r} folder={folderSlug(r.id)} mealTags={getMealTags(r)} />
                ))}
              </div>
            </section>
          </div>
          <p class="no-results" data-no-results hidden>
            Chưa có quán nào khớp bộ lọc này.
          </p>
        </>
      )}
    </div>
  </section>


  <!-- ================================================================
       RESTAURANT MODALS
       ================================================================ -->
  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" aria-modal="true" role="dialog" aria-label="Xem ảnh lớn">
    <button class="lightbox-close" aria-label="Đóng">✕</button>
    <button class="lightbox-prev" aria-label="Ảnh trước">‹</button>
    <button class="lightbox-next" aria-label="Ảnh sau">›</button>
    <div class="lightbox-img-wrap">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox-counter" id="lightbox-counter"></div>
  </div>

  <div id="rmodal-overlay" class="rmodal-overlay" aria-modal="true" role="dialog">

    {restaurantsWithContent.map(({ r, Content, folder, coverVersion, category, catMeta, starRating }) => {
      const d = r.data;
      const type         = d.type ?? 'restaurant';
      const isRestaurant = type === 'restaurant';
      const isCook       = type === 'cook';
      const isCollect    = type === 'collect';
      const filledStars  = '★'.repeat(starRating);
      const emptyStars   = '☆'.repeat(5 - starRating);
      const coverUrl     = `/restaurants/${folder}/cover.jpg?v=${coverVersion}`;
      return (
        <div class="rmodal-panel" id={`rmodal-restaurant-${folder}`} data-type={type}>

          {/* Hero */}
          <div class="rmodal-hero">
            <img src={coverUrl} alt={d.name} loading="lazy" />
            <button class="rmodal-close" type="button" aria-label="Đóng popup">✕</button>
          </div>

          {/* Body */}
          <div class="rmodal-body">

            {/* Category chip */}
            {catMeta && (
              <span class="rmodal-tag rmodal-type-chip" style={`--tag-bg:${catMeta.bg};--tag-color:${catMeta.color}`}>
                {catMeta.icon} {catMeta.label}
              </span>
            )}

            {/* Title */}
            <h2 class="rmodal-title">{d.name}</h2>

            {/* Restaurant-only: meta + score + dishes */}
            {isRestaurant && (
              <>
                <div class="rmodal-meta">
                  {d.address    && <span class="rmodal-meta-chip">📍 {d.address}</span>}
                  {d.neighborhood && <span class="rmodal-meta-chip">🏘 {d.neighborhood}</span>}
                  {d.parking_car && <span class="rmodal-meta-chip">🚗 Có chỗ đậu ô tô</span>}
                  {d.maps_url && (
                    <a class="rmodal-meta-chip rmodal-meta-chip--link" href={d.maps_url} target="_blank" rel="noopener">
                      🗺 Xem bản đồ
                    </a>
                  )}
                </div>
                <div class="rmodal-score">
                  {starRating > 0 && (
                    <span class="rmodal-stars" aria-label={`${starRating} trên 5 sao`}>
                      <span class="rmodal-stars-filled">{filledStars}</span>
                      <span class="rmodal-stars-empty">{emptyStars}</span>
                    </span>
                  )}
                  {d.price_range && <span class="rmodal-price">₫ {d.price_range}</span>}
                </div>
                {d.signature_dishes.length > 0 && (
                  <div class="rmodal-dishes">
                    {d.signature_dishes.map((dish) => (
                      <span class="rmodal-dish">🍽 {dish}</span>
                    ))}
                  </div>
                )}
              </>
            )}

            {/* Collect-only: link to source */}
            {isCollect && d.social_url && (
              <a class="rmodal-social-link" href={d.social_url} target="_blank" rel="noopener">
                🔗 Xem bài gốc
              </a>
            )}

            <hr class="rmodal-divider" />

            {/* Tagline / intro (cook + collect) */}
            {(isCook || isCollect) && d.tagline && (
              <p class="rmodal-intro">{d.tagline}</p>
            )}

            {/* Markdown content */}
            <div class="rmodal-prose">
              <Content />
            </div>

            {/* Photo gallery */}
            {d.photos.length > 0 && (
              <>
                <p class="rmodal-gallery-label">Hình ảnh</p>
                <div class="rmodal-gallery">
                  {d.photos.slice(0, 8).map((photo, idx) => (
                    <div
                      class="rmodal-gallery-item"
                      data-lightbox-src={`/restaurants/${folder}/${photo}`}
                      data-lightbox-idx={idx}
                      data-lightbox-group={folder}
                    >
                      <img
                        src={`/restaurants/${folder}/${photo}`}
                        alt=""
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              </>
            )}

            <a class="rmodal-detail-link" href={'/' + category + '/' + folder + '/'}>Xem trang chi tiết →</a>
          </div>
        </div>
      );
    })}

  </div><!-- /rmodal-overlay -->


  <!-- ================================================================
       SCRIPTS
       ================================================================ -->
  <script>
  /* ─────────────────────────────────────────────────────────────────
     INTRO OVERLAY CONTROLLER
  ───────────────────────────────────────────────────────────────── */
  (function () {
    const ov  = document.getElementById('intro-ov');
    const btn = document.getElementById('ov-explore-btn');
    const xucBtn = document.getElementById('ov-xuc-btn');
    if (!ov) return;

    // Category routes should open directly without replaying the homepage intro.
    if ((document.body.dataset.category ?? 'all') !== 'all') {
      ov.style.display = 'none';
      return;
    }

    /* ── Skip intro entirely on mobile (≤760px) ─────────────── */
    if (window.innerWidth <= 760) {
      ov.style.display = 'none';
      return;
    }

    /* Lock body scroll */
    document.body.style.overflow = 'hidden';

    /* ── Mouse parallax ──────────────────────────────────────────
       Each element with [data-px="N"] moves N fraction of cursor offset.
       Uses CSS `translate` property, which composes safely with
       keyframe animations on `transform`.
    ──────────────────────────────────────────────────────────── */
    const pxEls: NodeListOf<HTMLElement> = ov.querySelectorAll('[data-px]');
    const canParallax =
      window.matchMedia('(pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let dismissed = false;
    let rafPx = 0;

    if (canParallax) {
      window.addEventListener('mousemove', (e) => {
        if (dismissed || rafPx) return;
        const mx = (e as MouseEvent).clientX - window.innerWidth  / 2;
        const my = (e as MouseEvent).clientY - window.innerHeight / 2;

        rafPx = requestAnimationFrame(() => {
          pxEls.forEach((el) => {
            const d = parseFloat(el.dataset.px || '0');
            el.style.translate = `${mx * d}px ${my * d}px`;
          });
          rafPx = 0;
        });
      }, { passive: true });
    }

    /* ── Scroll-progress tilt (pre-dismiss feedback) ─────────────
       As wheel delta accumulates, the glass panel tilts in 3D —
       giving a satisfying "pulling" feel before dismiss fires.
    ──────────────────────────────────────────────────────────── */
    const glass  = ov.querySelector<HTMLElement>('.ov-glass');
    const manEl  = ov.querySelector<HTMLElement>('.ov-man');
    let scrollAcc = 0;
    const DISMISS_AT = 110;
    const AUTO_DISMISS_MS = 2400;

    /* ── Dismiss sequence ────────────────────────────────────────
       Phase 1 (~440ms): floating elements scatter outward.
       Phase 2 (460ms+): overlay slides off-screen upward.
    ──────────────────────────────────────────────────────────── */
    function dismiss() {
      if (dismissed) return;
      dismissed = true;

      if (rafPx) cancelAnimationFrame(rafPx);
      document.body.style.overflow = '';

      /* Scatter all floating elements */
      const floaters = Array.from(
        ov.querySelectorAll<HTMLElement>('.ov-chat-img, .ov-food')
      );

      const chatDirs: Record<string, [number, number]> = {
        'ov-chat-img--1': [-200, -200],
        'ov-chat-img--2': [ 240, -180],
        'ov-chat-img--3': [ 280,  -80],
        'ov-chat-img--4': [ 160,  180],
      };

      floaters.forEach((el, i) => {
        let dx = 0, dy = 0, dr = 0;

        const chatKey = Object.keys(chatDirs).find(k => el.classList.contains(k));
        if (chatKey) {
          [dx, dy] = chatDirs[chatKey];
          dx += (Math.random() - .5) * 80;
          dy += (Math.random() - .5) * 60;
          dr = (Math.random() - .5) * 80;
        } else {
          /* Food items — radial random scatter */
          const angle = Math.random() * Math.PI * 2;
          const dist  = 180 + Math.random() * 200;
          dx = Math.cos(angle) * dist;
          dy = Math.sin(angle) * dist - 60;
          dr = (Math.random() - .5) * 130;
        }

        el.style.setProperty('--dx',    `${dx}px`);
        el.style.setProperty('--dy',    `${dy}px`);
        el.style.setProperty('--dr',    `${dr}deg`);
        el.style.setProperty('--sc-dur', '.40s');
        el.style.setProperty('--sc-del', `${i * 0.026}s`);
        el.classList.add('is-scattering');
      });

      /* Man fades out */
      if (manEl) {
        manEl.style.setProperty('--sc-dur', '.50s');
        manEl.style.setProperty('--sc-del', '0.05s');
        manEl.classList.add('is-scattering');
      }

      /* Glass panel fades slightly */
      if (glass) {
        glass.style.transition = 'opacity .35s ease .1s';
        glass.style.opacity = '0';
      }

      /* Phase 2: slide overlay off-screen */
      setTimeout(() => ov.classList.add('ov--out'), 460);

      /* Phase 3: cleanup */
      setTimeout(() => {
        ov.style.display = 'none';
        ov.removeAttribute('role');
      }, 460 + 950);
    }

    /* ── Input listeners ─────────────────────────────────────── */

    /* Wheel: progressive tilt then dismiss */
    window.addEventListener('wheel', (e) => {
      if (dismissed) return;
      const delta = (e as WheelEvent).deltaY;
      if (delta <= 0) { scrollAcc = Math.max(0, scrollAcc - 10); return; }

      scrollAcc += delta;

      /* Tilt glass as scroll-progress feedback */
      if (glass) {
        const t = Math.min(scrollAcc / DISMISS_AT, 1);
        glass.style.transform =
          `translate(-50%,-50%) perspective(900px) rotateX(${t * 5}deg) scale(${1 - t * 0.025})`;
      }

      if (scrollAcc >= DISMISS_AT) dismiss();
    }, { passive: true });

    /* Touch swipe-up */
    let startY = 0;
    window.addEventListener('touchstart', (e) => {
      startY = (e as TouchEvent).touches[0].clientY;
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (startY - (e as TouchEvent).touches[0].clientY > 55) dismiss();
    }, { passive: true });

    /* Keyboard */
    window.addEventListener('keydown', (e) => {
      if (['ArrowDown', ' ', 'Enter', 'PageDown'].includes((e as KeyboardEvent).key)) {
        e.preventDefault(); dismiss();
      }
    });

    /* CTA button */
    if (btn) btn.addEventListener('click', dismiss);
    if (xucBtn) xucBtn.addEventListener('click', dismiss);
    window.setTimeout(dismiss, AUTO_DISMISS_MS);

  })();

  /* ─────────────────────────────────────────────────────────────────
     CONTENT AREA FILTER + BANNER STATE
  ───────────────────────────────────────────────────────────────── */
  const pageMeta: Record<string, { kicker: string; title: string; lines: string[] }> = {
    all: {
      kicker: 'Khám phá',
      title: 'Quán nên lưu lại',
      lines: ['Tui hay ăn nhất', 'Quán local ở Đà Lạt nè', 'Đồ ăn tui nấu'],
    },
    breakfast: {
      kicker: 'Ăn sáng',
      title: 'Quán ăn sáng',
      lines: ['Tui hay ăn nhất', 'Quán Đà Lạt', 'Quán đại trà'],
    },
    dinner: {
      kicker: 'Ăn trưa, tối',
      title: 'Quán ăn trưa, tối',
      lines: ['Tui hay ăn nhất', 'Quán Đà Lạt', 'Quán đại trà'],
    },
    drinks: {
      kicker: 'Ăn nhậu',
      title: 'Quán ăn nhậu',
      lines: ['Tui hay nhậu', 'Quán Đà Lạt', 'Quán đại trà'],
    },
    snack: {
      kicker: 'Ăn vặt',
      title: 'Quán ăn vặt',
      lines: ['Tui hay ăn', 'Quán Đà Lạt', 'Quán đại trà'],
    },
    dalat: {
      kicker: 'Đà Lạt',
      title: 'Quán local Đà Lạt',
      lines: ['Quán tui hay ăn', 'Các quán local Đà Lạt'],
    },
    cook: {
      kicker: 'Cà Can Cook',
      title: 'Đồ ăn tui nấu',
      lines: ['Đồ tui nấu', 'Reels bếp núc'],
    },
    collect: {
      kicker: 'Sưu tầm',
      title: 'Bài hay sưu tầm',
      lines: ['Bài post sưu tầm', 'Reels sưu tầm'],
    },
    explore_featured: {
      kicker: 'Khám phá',
      title: 'Tui hay ăn nhất',
      lines: ['Tui hay ăn nhất'],
    },
  };

  const heroPages = (() => {
    const el = document.querySelector<HTMLScriptElement>('[data-hero-pages]');
    if (!el?.textContent) return [];
    try { return JSON.parse(el.textContent) as Array<{ id: string; title: string; subtitle: string; image: string }>; }
    catch { return []; }
  })();

  const initialCategory = document.body.dataset.category ?? 'all';
  const state = { category: initialCategory, neighborhood: 'all', query: '' };
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
  const noResults   = document.querySelector<HTMLElement>('[data-no-results]');
  const heroTitle    = document.querySelector<HTMLElement>('[data-hero-title]');
  const heroSubtitle = document.querySelector<HTMLElement>('[data-hero-subtitle]');
  const heroImage    = document.querySelector<HTMLImageElement>('[data-hero-image]');

  const homeView   = document.querySelector<HTMLElement>('[data-content-rows]');
  const catView    = document.querySelector<HTMLElement>('[data-category-view]');
  const favSection = document.querySelector<HTMLElement>('[data-fav-section]');
  const favTitleEl = document.querySelector<HTMLElement>('[data-fav-title]');
  const allTitleEl = document.querySelector<HTMLElement>('[data-all-title]');
  const contentRows = document.querySelectorAll<HTMLElement>('[data-content-row]');

  const homeCards = homeView ? Array.from(homeView.querySelectorAll<HTMLElement>('.r-card')) : [];
  const favCards  = Array.from(document.querySelectorAll<HTMLElement>('[data-fav-track] .r-card'));
  const gridCards = Array.from(document.querySelectorAll<HTMLElement>('[data-all-grid] .r-card'));

  const matchesCategory = (card: HTMLElement) => {
    if (state.category === 'all') return true;
    if (state.category === 'explore_featured') return card.dataset.explore === '1';
    return (card.dataset.mealTags ?? 'all').split(' ').includes(state.category);
  };
  const matchesNeighborhood = (card: HTMLElement) =>
    state.neighborhood === 'all' || (card.dataset.neighborhood ?? '') === state.neighborhood;
  const matchesSearch = (card: HTMLElement) =>
    !state.query || (card.dataset.search ?? '').includes(state.query);

  const apply = () => {
    const visibleSlugs = new Set<string>();

    if (state.category === 'all') {
      /* ── Trang chủ: các hàng scroll ngang, tối đa 10 bài ── */
      if (homeView) homeView.hidden = false;
      if (catView)  catView.hidden  = true;
      homeCards.forEach((card) => {
        const show = matchesNeighborhood(card) && matchesSearch(card);
        card.style.display = show ? '' : 'none';
        if (show) visibleSlugs.add(card.dataset.modal ?? '');
      });
      contentRows.forEach((row) => {
        const anyVisible = Array.from(row.querySelectorAll<HTMLElement>('.r-card'))
          .some((card) => card.style.display !== 'none');
        row.hidden = !anyVisible;
      });
    } else {
      /* ── Trang listing category: hàng favorite + grid tất cả quán ── */
      if (homeView) homeView.hidden = true;
      if (catView)  catView.hidden  = false;

      let favVisible = 0;
      favCards.forEach((card) => {
        const show = card.dataset.favorite === '1' && matchesCategory(card) && matchesNeighborhood(card) && matchesSearch(card);
        card.style.display = show ? '' : 'none';
        if (show) favVisible += 1;
      });
      if (favSection) favSection.hidden = favVisible === 0 || state.category === 'explore_featured';

      gridCards.forEach((card) => {
        const show = matchesCategory(card) && matchesNeighborhood(card) && matchesSearch(card);
        card.style.display = show ? '' : 'none';
        if (show) visibleSlugs.add(card.dataset.modal ?? '');
      });
    }

    if (resultCount) resultCount.textContent = `${visibleSlugs.size} quán`;
    if (noResults)   noResults.hidden = visibleSlugs.size !== 0;
  };

  const renderPageChrome = (value: string) => {
    const meta = pageMeta[value] ?? pageMeta.all;
    const hero = heroPages.find((item) => item.id === value) ?? heroPages[0];
    if (heroTitle && hero) heroTitle.textContent = hero.title;
    if (heroSubtitle && hero) heroSubtitle.textContent = hero.subtitle;
    if (heroImage && hero) {
      // Browsers prefer srcset over src, so update both for each mascot.
      heroImage.srcset = hero.id === 'all'
        ? '/images/characters-optimized/cenix-kham-pha-sm.png 280w, /images/characters-optimized/cenix-kham-pha.png 720w'
        : hero.image;
      heroImage.src = hero.image;
    }

    if (value === 'all') {
      meta.lines.forEach((line, index) => {
        const title = document.querySelector<HTMLElement>('[data-row-title="row-' + (index + 1) + '"]');
        if (title) title.textContent = line;
      });
    } else {
      if (favTitleEl) favTitleEl.textContent = meta.lines[0] ?? 'Tui hay ăn nhất';
      if (allTitleEl) allTitleEl.textContent = 'Tất cả các quán';
    }
  };

  const setCategory = (value: string) => {
    const nextUrl = value === 'all' ? '/' : '/' + value;
    if (window.location.pathname !== nextUrl) window.location.assign(nextUrl);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-sidebar-category]').forEach((item) =>
    item.addEventListener('click', () => {
      setCategory(item.dataset.sidebarCategory ?? 'all');
    })
  );
  document.querySelector<HTMLInputElement>('[data-food-search]')?.addEventListener('input', (e) => {
    state.query = (e.currentTarget as HTMLInputElement).value.trim().toLocaleLowerCase('vi');
    apply();
  });
  document.querySelector<HTMLSelectElement>('[data-location-select]')?.addEventListener('change', (e) => {
    state.neighborhood = (e.currentTarget as HTMLSelectElement).value;
    apply();
  });

  /* Nút ‹ › lướt track ngang (hoạt động 2 chiều) */
  document.querySelectorAll<HTMLButtonElement>('[data-track-prev], [data-track-next]').forEach((button) => {
    button.addEventListener('click', () => {
      const track = button.closest('.content-row')?.querySelector<HTMLElement>('.content-row-track');
      if (!track) return;
      const dir = 'trackPrev' in button.dataset ? -1 : 1;
      track.scrollBy({ left: dir * Math.round(track.clientWidth * 0.85), behavior: 'smooth' });
    });
  });

  /* "Xem thêm" (desktop header + mobile card cuối track) → vào trang listing */
  document.querySelectorAll<HTMLButtonElement>('[data-row-more]').forEach((button) => {
    button.addEventListener('click', () => {
      setCategory(button.dataset.rowMore ?? 'all');
      document.getElementById('explore')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  renderPageChrome(state.category);
  apply();
  </script>

  <!-- Restaurant Modal Controller -->
  <script>
  /* ─────────────────────────────────────────────────────────────────
     RESTAURANT MODAL
  ───────────────────────────────────────────────────────────────── */
  (function () {
    const overlay = document.getElementById('rmodal-overlay') as HTMLElement | null;
    if (!overlay) return;

    function openModal(slug: string) {
      const panel = document.getElementById('rmodal-' + slug) as HTMLElement | null;
      if (!panel) return;

      /* Hide any previously active panel */
      overlay!.querySelectorAll<HTMLElement>('.rmodal-panel.is-active').forEach((p) => {
        p.classList.remove('is-active');
      });

      panel.classList.add('is-active');
      overlay!.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      /* Scroll panel to top */
      panel.scrollTop = 0;
      overlay!.scrollTop = 0;
    }

    function closeModal() {
      overlay!.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => {
        overlay!.querySelectorAll<HTMLElement>('.rmodal-panel.is-active').forEach((p) => {
          p.classList.remove('is-active');
        });
      }, 280);
    }

    /* Open on card click */
    document.querySelectorAll<HTMLElement>('[data-modal]').forEach((card) => {
      card.addEventListener('click', () => {
        const slug = card.dataset.modal;
        if (slug) openModal(slug);
      });
    });

    /* Close on backdrop click (click outside panel) */
    overlay.addEventListener('click', (e) => {
      if ((e.target as HTMLElement) === overlay) closeModal();
    });

    /* Close buttons inside panels */
    overlay.querySelectorAll<HTMLElement>('.rmodal-close').forEach((btn) => {
      btn.addEventListener('click', closeModal);
    });

    /* Escape key */
    document.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && overlay.classList.contains('is-open')) {
        closeModal();
      }
    });

    /* ── Lightbox ─────────────────────────────────────────────── */
    const lb         = document.getElementById('lightbox') as HTMLElement;
    const lbImg      = document.getElementById('lightbox-img') as HTMLImageElement;
    const lbCounter  = document.getElementById('lightbox-counter') as HTMLElement;
    const lbClose    = lb.querySelector<HTMLElement>('.lightbox-close')!;
    const lbPrev     = lb.querySelector<HTMLElement>('.lightbox-prev')!;
    const lbNext     = lb.querySelector<HTMLElement>('.lightbox-next')!;

    let lbItems: string[] = [];
    let lbIndex = 0;

    function lbShow(index: number) {
      lbIndex = index;
      lbImg.src = lbItems[lbIndex];
      lbCounter.textContent = `${lbIndex + 1} / ${lbItems.length}`;
      lbPrev.classList.toggle('is-hidden', lbIndex === 0);
      lbNext.classList.toggle('is-hidden', lbIndex === lbItems.length - 1);
    }

    function lbOpen(group: string, idx: number) {
      const items = document.querySelectorAll<HTMLElement>(`[data-lightbox-group="${group}"]`);
      lbItems = Array.from(items).map(el => el.dataset.lightboxSrc!);
      lb.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      lbShow(idx);
    }

    function lbCloseBox() {
      lb.classList.remove('is-open');
      document.body.style.overflow = '';
      lbImg.src = '';
    }

    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox-group]');
      if (el) {
        lbOpen(el.dataset.lightboxGroup!, Number(el.dataset.lightboxIdx ?? 0));
        return;
      }
      if (e.target === lb) lbCloseBox();
    });

    lbClose.addEventListener('click', lbCloseBox);
    lbPrev.addEventListener('click', () => lbShow(lbIndex - 1));
    lbNext.addEventListener('click', () => lbShow(lbIndex + 1));

    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('is-open')) return;
      if ((e as KeyboardEvent).key === 'Escape') lbCloseBox();
      if ((e as KeyboardEvent).key === 'ArrowLeft'  && lbIndex > 0) lbShow(lbIndex - 1);
      if ((e as KeyboardEvent).key === 'ArrowRight' && lbIndex < lbItems.length - 1) lbShow(lbIndex + 1);
    });
  })();
  </script>

</BaseLayout>
