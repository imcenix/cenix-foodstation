# =====================================================
# Cenix FoodStation — .gitignore
# =====================================================

# Environment / credentials
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.astro/
.cache/

# OS / Editor noise
.DS_Store
._.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# Logs
*.log
npm-debug.log*

# Deployment artifacts
.deploy/
deploy.log

# Pre-build symlinks under public/ (regenerated by scripts/link-assets.mjs)
public/restaurants*
public/images*

# Research / Resource folders (only for internal reference, not for site)
Research/
Resource/
